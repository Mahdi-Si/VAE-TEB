# synthetic_v2 generated artifacts (S0-T08).
#
# The nested model_experiment/.gitignore rule `results/**/*.ckpt` is anchored to
# model_experiment/, NOT to synthetic_v2/, so `git check-ignore` confirms synthetic_v2's
# own results/ tree is otherwise committable. This file ignores the per-arm generated
# artifacts (checkpoints, per-sample eval arrays, generated reports and figures, training
# logs) while keeping code, small config, and hand-written docs tracked.
#
# synthetic_v2/data/ is already covered by the repo-root `data/` rule.

# All generated run artifacts live under results/<tag>/<arm>/...
results/**/*.ckpt
results/**/*.pt
results/**/*.pth
results/**/*.npz
results/**/*.npy
# Generated metrics / manifests: metrics.json, realizability.json, recovery.json,
# beta_select.json, lag_intervention.json, cmi.json, summary.json, and the analysis CSVs
# (per_sample.csv, per_horizon.csv, reliability.csv, calibration_by_te.csv, cmi_table.csv).
# Without these the tree is never clean after a pilot run, which S8-T02 asserts.
results/**/*.json
results/**/*.csv
results/**/report.md
results/**/arms_report.md
results/**/figures/
results/**/logs/
# Generated figures that do NOT live under a figures/ dir. The shipped
# testing/analyses/calibration.py writes reliability.pdf / coverage.pdf /
# sharpness_by_horizon.pdf into its own output_dir (results/<tag>/<arm>/<split>/calibration/),
# and the per-sample testing diagnostics write PDFs under test_plots/samples_diag/. Without
# these two rules `git status` is dirty after --stage calibration, which S8-T02 asserts it
# is not.
results/**/*.pdf
results/**/*.png

__pycache__/
*.pyc
